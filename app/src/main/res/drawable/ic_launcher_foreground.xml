<!--
    Eiger, Mönch and Jungfrau as seen from Mürren, left to right, each a little
    higher than the last. Alpenglow on the summits, the moon above, and the dark
    Schwarzmönch-style ridge in front. Peaks stay inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Moon -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56.6,22 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 Z" />

    <!-- Snow: Eiger (sharp), Mönch (dome), Jungfrau (tallest, with a shoulder) -->
    <path
        android:fillColor="#EEF2F5"
        android:pathData="M20,84 L36,42 L44,55 Q50,36 55,36 Q60,36 62,44 L71,29 L79,46 L83,44 L90,84 Z" />

    <!-- Alpenglow on the summits -->
    <group>
        <clip-path android:pathData="M20,84 L36,42 L44,55 Q50,36 55,36 Q60,36 62,44 L71,29 L79,46 L83,44 L90,84 Z" />
        <path
            android:fillColor="#F2934E"
            android:pathData="M0,0 H108 V44 L0,50 Z" />
    </group>

    <!-- Dark rock ridge in front -->
    <path
        android:fillColor="#2C3742"
        android:pathData="M0,108 L0,76 L14,70 L28,75 L40,68 L52,74 L64,69 L76,75 L90,70 L108,76 L108,108 Z" />
</vector>
